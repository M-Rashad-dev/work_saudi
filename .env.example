APP_NAME="شركات اليوم"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://your-vps-ip-or-domain
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MySQL 8 — bound to 127.0.0.1 only
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saudi_dev_daily
DB_USERNAME=saudi_dev_daily
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false   # true once the site is on https

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=work_

# Redis — bound to 127.0.0.1 only. phpredis (php8.3-redis) on the VPS; "predis" works without the extension.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Separate Redis DBs + prefixes so this app never collides with other apps on the same server.
REDIS_DB=2
REDIS_CACHE_DB=3
REDIS_PREFIX=work_
HORIZON_PREFIX=work_horizon:

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# ---- Outreach pipeline ---------------------------------------------------
SEARXNG_URL=http://127.0.0.1:8888
SERPER_API_KEY=            # optional, free credits only
LLM_DRIVERS=gemini,ollama,heuristic
GEMINI_API_KEY=            # Google AI Studio free key, no billing
GEMINI_MODEL=
LLM_RATE_PER_MINUTE=10
OLLAMA_URL=                # optional, e.g. http://127.0.0.1:11434
OLLAMA_MODEL=              # optional, e.g. qwen2.5:3b
BROWSERSHOT_NODE_PATH=     # e.g. /usr/bin/node
BROWSERSHOT_CHROME_PATH=   # e.g. /usr/bin/chromium-browser
BROWSERSHOT_ENABLED=false  # set true after installing Chromium (DEPLOYMENT.md step 9)
BROWSERSHOT_NODE_MODULES_PATH=  # e.g. /usr/lib/node_modules (global puppeteer)
CRAWLER_ALLOW_INSECURE_TLS=true   # read sites with a broken TLS chain too (no cert check, read-only public pages)
